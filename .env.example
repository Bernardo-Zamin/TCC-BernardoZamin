# Copy to .env and fill in. Never commit .env.

# DeepInfra key (Qwen, DeepSeek, gpt-oss).
DEEPINFRA_API_KEY=

# Spending cap on DeepInfra, in USD, across all runs. The campaign cost about $9.50.
TCC_BUDGET_CAP_USD=5

# Anthropic API key (Claude Sonnet 5).
ANTHROPIC_API_KEY=

# Spending cap on Anthropic, in USD. With 0, Claude spends nothing. The campaign
# cost about $25.50.
TCC_BUDGET_CAP_ANTHROPIC_USD=0
